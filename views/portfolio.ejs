<%- include('partials/header', { activePage: 'portfolio' }) %>

<main class="portfolio-page">

    <!-- PAGE INTRODUCTION -->
    <section class="portfolio-hero">
        <p class="section-label">MY WORK</p>
        <h1>My Projects</h1>

        <p>
            Welcome to my portfolio! Here are some of the projects
            I have worked on throughout my time at RP. Feel free to
            browse & should you have any questions, you could contact
            me through the "Contact" button above.
        </p>
    </section>


    <!-- PROJECT FILTERS -->
    <section class="portfolio-projects">

        <div class="project-filters">
            <button class="filter-btn active" data-category="all">
                All
            </button>

            <button class="filter-btn" data-category="Web Application">
                Web Apps
            </button>

            <button class="filter-btn" data-category="Mobile">
                Mobile Apps
            </button>

            <button class="filter-btn" data-category="Competitions">
                Competitions
            </button>
        </div>


        <!-- PROJECT CARDS -->
        <div class="projects-grid">

            <% projects.forEach(project => { %>

                <div class="project-card"
                     data-category="<%= project.category %>">

                    <div class="project-image">
                        <img
                            src="<%= project.image %>"
                            alt="<%= project.title %>"
                        >
                    </div>

                    <div class="project-info">

                        <span class="project-category">
                            <%= project.categoryLabel %>
                        </span>

                        <h2><%= project.title %></h2>

                        <p><%= project.description %></p>

                        <div class="project-tech">
                            <% project.technologies.forEach(tech => { %>
                                <span><%= tech %></span>
                            <% }) %>
                        </div>

                        <a href="/projects/<%= project.slug %>" class="project-link">
                          View Project →
                        </a>

                    </div>
                </div>

            <% }) %>

        </div>

    </section>

</main>

<%- include('partials/footer') %>